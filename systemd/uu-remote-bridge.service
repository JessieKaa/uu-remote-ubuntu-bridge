[Unit]
Description=UU Remote bridge for the live GNOME desktop
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-%h/.config/uu-remote-bridge/environment
ExecStart=%h/.local/bin/uu-remote-bridge
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
KillMode=control-group
LimitNOFILE=65536
# The relay normally stays below 2 GiB. Contain an upstream Wine/thread leak
# inside this restartable service instead of allowing it to stall the desktop.
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=2G
TasksMax=1024
OOMPolicy=stop

[Install]
WantedBy=default.target
